# Who the signed-in person is to the agents. The controllers generated by
# managed_agents use this for everything they look up, so nobody reaches a
# session or a credential that isn't theirs.
module AgentAccess
  extend ActiveSupport::Concern

  private

  # Sessions belong to this record. Return the signed-in user, or their
  # account to share sessions across an organisation.<% if unscoped? %>
  #
  # No authentication was detected, so this is nil and every session without
  # an owner is visible to everyone. Change it before deploying.<% end %>
  def agent_owner
    <%= owner_expression %>
  end

  def agent_sessions
    ManagedAgents::Session.owned_by(agent_owner)
  end

  # The groups of credentials this person may manage, by label. "personal"
  # connections are used only by their own sessions. To keep shared service
  # accounts in the hands of admins, leave "organization" out for others.
  def agent_vault_owners
    <%= vault_owners_expression %>
  end
end
